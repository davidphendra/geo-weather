{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org/"
  },
  "Csp": {
    "EnforceInDevelopment": false,
    "ReportPath": "/_csp/report"
  },
  "Database": {
    "DataDirectory": "App_Data",
    "Files": {
      "Geography": "geography.db",
      "Favorites": "favorites.db",
      "Notes": "notes.db"
    }
  },
  "Observability": {
    "Enabled": false,
    "ExportTarget": "AzureMonitor",
    "SamplingRatio": 0.1
  }
}
