{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org/",
    "Resilience": {
      "MaxRetryAttempts": 3,
      "RetryBaseDelaySeconds": 1,
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 30
    }
  },
  "Csp": {
    "EnforceInDevelopment": false,
    "ReportPath": "/_csp/report"
  },
  "Location": {
    "DefaultCountryCode": "ID",
    "DefaultCityName": "Jakarta"
  },
  "Database": {
    "DataDirectory": "App_Data",
    "Files": {
      "Geography": "geography.db",
      "Journal": "journal.db"
    }
  },
  "Observability": {
    "Enabled": false,
    "ExportTarget": "AzureMonitor",
    "SamplingRatio": 0.1
  }
}
