<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- Enables `dotnet user-secrets` for OpenWeather:ApiKey in Development. No secret is committed. -->
        <UserSecretsId>0f3c9b2e-7d41-4a8c-9e2b-6c5f1a8d3b74</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Modules\Geography\Weather.Modules.Geography.Application\Weather.Modules.Geography.Application.csproj" />
        <ProjectReference Include="..\Modules\Geography\Weather.Modules.Geography.Infrastructure\Weather.Modules.Geography.Infrastructure.csproj" />
        <ProjectReference Include="..\Modules\Weather\Weather.Modules.Weather.Application\Weather.Modules.Weather.Application.csproj" />
        <ProjectReference Include="..\Modules\Weather\Weather.Modules.Weather.Infrastructure\Weather.Modules.Weather.Infrastructure.csproj" />
        <ProjectReference Include="..\Modules\Journal\Weather.Modules.Journal.Application\Weather.Modules.Journal.Application.csproj" />
        <ProjectReference Include="..\Modules\Journal\Weather.Modules.Journal.Infrastructure\Weather.Modules.Journal.Infrastructure.csproj" />
        <ProjectReference Include="..\BuildingBlocks\Weather.BuildingBlocks.Infrastructure\Weather.BuildingBlocks.Infrastructure.csproj" />
        <ProjectReference Include="..\BuildingBlocks\Weather.BuildingBlocks.Application\Weather.BuildingBlocks.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Weather.WebUI.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Runtime SQLite state (ADR-0013): created at runtime, never built or published. -->
        <Content Remove="App_Data\**\*" />
        <None Update="App_Data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Tailwind toolchain is author-time only; keep it out of build/publish output. -->
        <Content Remove="node_modules/**/*" />
        <None Remove="node_modules/**/*" />
        <Compile Remove="node_modules/**/*" />
    </ItemGroup>

    <!-- Tailwind is built at author time. The compiled wwwroot/app.css is committed, so a plain
         dotnet build (and CI/Preflight) needs no Node; this target only runs when it is missing. -->
    <Target Name="BuildTailwind" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/app.css')">
        <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')" />
        <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

    <!--
      Self-describing manifest for the deployed artifact (e16s01). Written into the publish folder so
      operators can identify a build without running it. Properties are supplied by Nerdbank.GitVersioning.
    -->
    <Target Name="WriteBuildInfo" AfterTargets="Publish">
        <ItemGroup>
            <_BuildInfoLine Include="{" />
            <_BuildInfoLine Include="  &quot;version&quot;: &quot;$(AssemblyInformationalVersion.Split('+')[0])&quot;," />
            <_BuildInfoLine Include="  &quot;informationalVersion&quot;: &quot;$(AssemblyInformationalVersion)&quot;," />
            <_BuildInfoLine Include="  &quot;commit&quot;: &quot;$(GitCommitId)&quot;," />
            <_BuildInfoLine Include="  &quot;publicRelease&quot;: &quot;$([System.String]::Copy('$(PublicRelease)').ToLowerInvariant())&quot;," />
            <_BuildInfoLine Include="  &quot;builtAtUtc&quot;: &quot;$([System.DateTime]::UtcNow.ToString('o'))&quot;" />
            <_BuildInfoLine Include="}" />
        </ItemGroup>
        <WriteLinesToFile File="$(PublishDir)build-info.json" Lines="@(_BuildInfoLine)" Overwrite="true" />
    </Target>

</Project>
