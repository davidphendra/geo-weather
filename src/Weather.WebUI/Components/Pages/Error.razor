@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="w-full px-gutter md:px-margin-desktop py-space-xl max-w-[1600px] mx-auto">
    <section class="bg-surface-container-lowest shadow-sm rounded-xl p-space-lg md:p-space-xl flex flex-col gap-space-md">
        <span class="font-label-sm text-label-sm text-error uppercase font-semibold tracking-wider">Request Failed</span>
        <h1 class="font-headline-lg text-headline-lg text-on-surface font-semibold">An error occurred while processing your request.</h1>
        @if (ShowRequestId)
        {
            <p class="font-code-sm text-code-sm text-on-surface-variant">
                Request ID: <code class="text-secondary">@RequestId</code>
            </p>
        }
        <p class="font-body-md text-body-md text-on-surface-variant">
            If the problem continues, contact the operator with the request ID above.
        </p>
    </section>
</div>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
