@page "/favorites"
@rendermode InteractiveServer
@using System.Text.Json
@inject WeatherApiClient Api
@inject EntityFilterModel Filter
@inject CommandDispatchModel Dispatch

<SeoHead Title="Favorites & Saved Notes — GeoWeather"
         Description="Your saved cities and weather notes in one place."/>

<div class="w-full px-gutter-desktop py-space-xl flex flex-col gap-space-xl max-w-[1600px] mx-auto">
    <MetricsStrip FavoritesCount="Filter.All.Count"
                  LastMutation="Dispatch.History.Count > 0 ? Dispatch.History[0].At : null"/>

    <ProblemBanner Problem="_error"/>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
        <div class="lg:col-span-8 flex flex-col gap-space-lg">
            <EntityControlBar OnNewCommand="FocusQuickAddAsync"/>
            <EntityTable Rows="Filter.Visible" TotalCount="Filter.All.Count" OnInspect="OpenInspector"/>
            <QuickAddCommandForm @ref="_quickAdd" OnDispatched="ReloadAsync"/>
        </div>
        <div class="lg:col-span-4 flex flex-col gap-space-lg">
            <CqrsMutationFeed/>
            <PipelineTopologyCard/>
        </div>
    </div>
</div>

<RawJsonInspectorModal Visible="_inspecting is not null" Json="_inspectingJson" OnClose="CloseInspector"/>

@code {
    private QuickAddCommandForm? _quickAdd;
    private FavoriteCityModel? _inspecting;
    private string? _inspectingJson;
    private ApiProblem? _error;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;

        try
        {
            Filter.Set(await Api.GetFavoritesAsync(CancellationToken.None));
        }
        catch (WeatherApiException exception)
        {
            _error = exception.Problem;
        }
    }

    private Task FocusQuickAddAsync() => _quickAdd?.FocusAsync() ?? Task.CompletedTask;

    private void OpenInspector(FavoriteCityModel row)
    {
        _inspecting = row;
        _inspectingJson = JsonSerializer.Serialize(row, new JsonSerializerOptions { WriteIndented = true });
    }

    private void CloseInspector()
    {
        _inspecting = null;
        _inspectingJson = null;
    }
}
