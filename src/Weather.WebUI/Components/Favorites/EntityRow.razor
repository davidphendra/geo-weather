@using System.Globalization
@if (Row is { } row)
{
    <tr class="group hover:bg-surface-container-low/50 transition-colors">
        <td class="py-3 px-space-lg font-code-sm text-code-sm text-on-surface-variant">
            <span class="font-mono text-secondary font-medium">@row.Id.ToString("N")[..8]</span>
        </td>
        <td class="py-3 px-space-md">
            <div class="font-headline-sm text-headline-sm text-on-surface">@row.City</div>
            <div class="font-code-sm text-code-sm text-on-surface-variant">@row.CountryCode</div>
        </td>
        <td class="py-3 px-space-md"><TypeBadge Kind="Favorite"/></td>
        <td class="py-3 px-space-md">
            @* The saved-city contract carries no weather snapshot, so this cell is honestly empty (D3). *@
            <SnapshotCell/>
        </td>
        <td class="py-3 px-space-md max-w-xs">
            <span class="font-code-sm text-code-sm text-on-surface-variant">Not available</span>
        </td>
        <td class="py-3 px-space-md font-code-sm text-code-sm text-on-surface-variant whitespace-nowrap">
            @row.CreatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
        </td>
        <td class="py-3 px-space-lg text-right whitespace-nowrap">
            <button type="button" class="p-1 rounded text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors"
                    aria-label="Inspect snapshot JSON" @onclick="() => OnInspect.InvokeAsync(Row)">
                <span class="material-symbols-outlined text-[18px]">code</span>
            </button>
        </td>
    </tr>
}

@code {
    [Parameter] public FavoriteCityModel? Row { get; set; }

    [Parameter] public EventCallback<FavoriteCityModel> OnInspect { get; set; }
}
