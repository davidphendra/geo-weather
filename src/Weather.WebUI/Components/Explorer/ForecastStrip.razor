@using System.Globalization
<section class="bg-surface-container-lowest shadow-sm rounded-xl p-space-lg md:p-space-xl">
    <div class="flex items-center justify-between mb-space-md">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold flex items-center gap-2">
            <span class="material-symbols-outlined text-secondary text-[20px]">calendar_view_week</span>
            5-Day Predictive Ensemble Forecast
        </h3>
        @if (Forecast is not null)
        {
            <span class="font-code-sm text-code-sm text-on-surface-variant">Source: OpenWeather 5d/3h</span>
        }
    </div>

    @if (Forecast is { Days.Count: > 0 })
    {
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-space-sm">
            @for (int index = 0; index < Forecast.Days.Count; index++)
            {
                <ForecastDayCard Day="Forecast.Days[index]" Today="index == 0"/>
            }
        </div>
    }
    else
    {
        <div class="p-space-lg rounded-lg bg-surface-container-low text-center font-code-sm text-code-sm text-on-surface-variant">
            Forecast not available — current conditions only.
        </div>
    }
</section>

@code {
    [Parameter] public WeatherForecastModel? Forecast { get; set; }
}
