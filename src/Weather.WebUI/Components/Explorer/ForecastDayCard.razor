@using System.Globalization
@if (Day is not null)
{
    <div class="p-space-md bg-surface-container-low rounded-lg flex flex-col items-center text-center gap-space-xs">
        <span class="font-code-sm text-code-sm font-bold text-on-surface">
            @Day.Date.ToString("ddd", CultureInfo.InvariantCulture).ToUpperInvariant()@(Today ? " (TODAY)" : "")
        </span>
        <span class="material-symbols-outlined text-secondary text-[26px]">
            @SkyConditionIcon.For(Day.SkyCondition)
        </span>
        <div class="flex items-baseline gap-1 mt-1">
            <span class="font-body-md text-body-md font-bold text-on-surface">
                @Day.High.Celsius.ToString("0", CultureInfo.InvariantCulture)°
            </span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">
                / @Day.Low.Celsius.ToString("0", CultureInfo.InvariantCulture)°
            </span>
        </div>
        <div class="flex items-center gap-1 text-[11px] text-secondary font-code-sm">
            <span class="material-symbols-outlined text-[12px]">umbrella</span>
            <span>@Day.PrecipitationProbabilityPercent%</span>
        </div>
    </div>
}

@code {
    [Parameter] public ForecastDayModel? Day { get; set; }

    [Parameter] public bool Today { get; set; }
}
