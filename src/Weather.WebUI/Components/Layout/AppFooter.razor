@using System.Runtime.InteropServices

<footer class="w-full bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="w-full px-gutter-desktop py-space-md flex flex-col md:flex-row items-center justify-between gap-space-md font-code-sm text-code-sm text-on-surface-variant">
        <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-space-md">
            <span>Kestrel WebHost [@RuntimeInformation.RuntimeIdentifier]</span>
            <span class="hidden md:inline">@RuntimeInformation.OSDescription</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-space-lg">
            <span>v@(AppVersion.Current.Version)</span>
            <span>© @DateTime.UtcNow.Year GeoWeather</span>
        </div>
    </div>
</footer>
