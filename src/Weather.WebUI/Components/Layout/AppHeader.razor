<header class="fixed top-0 w-full z-50 bg-primary-container shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 w-full px-gutter-desktop flex items-center justify-between gap-space-lg">
        <div class="flex items-center gap-space-md">
            <img src="img/geoweather-mark.svg" alt="GeoWeather" class="h-8 w-8 object-contain"/>
            <div class="flex flex-col">
                <div class="flex items-center gap-space-xs">
                    <span class="font-headline-sm text-headline-sm text-on-primary tracking-tight font-semibold">GeoWeather</span>
                    <span class="font-code-sm text-code-sm px-1.5 py-0.5 rounded bg-primary-container text-tertiary-fixed font-medium">@Framework</span>
                </div>
                <span class="font-code-sm text-code-sm text-on-primary-container">@Version</span>
            </div>
        </div>
        <AppNav/>
    </div>
</header>

@code {
    private static readonly string Version = AppVersion.Current.Version;

    private static readonly string Framework = $".NET {Environment.Version.Major}";
}
